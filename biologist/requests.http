@token = {{login.response.body.token}}

# @name createBlog
//Antwort auf diesen Request wird unter createBlog gespeichert
POST http://localhost:3003/api/blogs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Blog zum Löschen",
  "author": "Norbert",
  "url": "http://loeschmich.de",
  "likes": 0
}

###

@blogId = {{createBlog.response.body.id}}
DELETE http://localhost:3003/api/blogs/{{blogId}}
Authorization: Bearer {{token}}

