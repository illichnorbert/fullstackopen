  "password": "geheim123"
}

###
@token = {{login.response.body.token}}

POST http://localhost:3003/api/blogs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Blog mit Token",
  "author": "Norbert",
  "url": "http://mittoken.de",
  "likes": 7
}




